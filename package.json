{
  "name": "lolo-desktop-pet",
  "version": "1.0.4",
  "description": "lolo 桌面萌宠 (Windows)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --config",
    "dist:mac": "electron-builder --mac",
    "dist:win7": "electron-builder --win --config build/win7.json",
    "protect": "node build/protect.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.9.0"
  },
  "build": {
    "appId": "com.lolo.desktoppet",
    "productName": "lolo桌宠",
    "executableName": "lolo",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "!_src_plain/**",
      "config/**/*",
      "src/**/*",
      "assets/**/*",
      "!assets/videos/**/*.mp4",
      "!assets/videos/**/*.webm",
      "!assets/videos/hevc_backup/**",
      "!assets/videos/old_grab_drop_blackbg.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "3183276820-afk",
        "repo": "lolo-pet",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon/lolo.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "lolo桌宠.exe"
    },
    "nsis": {
      "artifactName": "lolo桌宠-setup-${version}.exe",
      "createDesktopShortcut": true,
      "shortcutName": "lolo桌宠"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon/mac/icon.icns",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": "x64" },
        { "target": "dmg", "arch": "arm64" }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "lolo ${version}",
      "icon": "assets/icon/mac/icon.icns",
      "background": "build/background.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "rcedit": "^5.0.2"
  }
}
