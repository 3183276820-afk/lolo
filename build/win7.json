{
  "appId": "com.lolo.desktoppet",
  "productName": "lolo桌宠",
  "executableName": "lolo",
  "directories": {
    "output": "dist"
  },
  "compression": "maximum",
  "asar": true,
  "files": [
    "main.js",
    "preload.js",
    "!_src_plain/**",
    "config/**/*",
    "src/**/*",
    "assets/**/*",
    "!assets/videos/**/*.mp4",
    "!assets/videos/**/*.webm",
    "!assets/videos/hevc_backup/**",
    "!assets/videos/old_grab_drop_blackbg.png"
  ],
  "publish": null,
  "win": {
    "target": [
      "portable"
    ],
    "icon": "assets/icon/lolo.ico",
    "signAndEditExecutable": false
  },
  "portable": {
    "artifactName": "lolo-desktop-pet-win7-${arch}.exe"
  }
}
